# Copy this file to .env.local and fill in the values from your Supabase project
# (Project Settings -> API in the Supabase dashboard).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key (Project Settings -> API -> service_role secret).
# Server-only -- never expose this to the browser. Used to cache
# search results into the media_item table.
SUPABASE_SERVICE_ROLE_KEY=

# TMDB API Read Access Token (themoviedb.org -> Settings -> API).
# Server-only -- powers movie/TV search.
TMDB_READ_ACCESS_TOKEN=

# Google Books API key (console.cloud.google.com -> enable "Books API" ->
# Credentials -> API key). Optional -- works unauthenticated at a lower
# quota, but a free key is recommended for reliability. Server-only.
GOOGLE_BOOKS_API_KEY=

# Base URL of this app, used to build the email confirmation link.
# Locally this is http://localhost:3000; on Vercel, set it to your
# production URL (e.g. https://shelfie-swart-five.vercel.app).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
